{
  "name": "@cartridgefi/shared-types",
  "version": "2.0.0",
  "type": "module",
  "description": "CartridgeManifest v2.0 Zod v4 schemas, deterministic 10^9 bigint fixed-point scoring & ELO math, Anchor account layouts, and binary WS frames",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
