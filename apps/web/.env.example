# CartridgeFi Web App (@cartridgefi/web) — Vercel & Local Environment Configuration
# All variables below are optional on Vercel; sensible Solana Devnet + MagicBlock defaults
# activate automatically with graceful fallback when external Rust daemons are offline.

NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_MAGICBLOCK_ROUTER_URL=https://devnet-router.magicblock.app
NEXT_PUBLIC_MAGICBLOCK_TEE_URL=https://devnet-tee.magicblock.app

# Optional external Rust edge services (leave empty on Vercel to use direct Devnet RPC + built-in Next.js edge routes)
NEXT_PUBLIC_CORE_API_URL=
NEXT_PUBLIC_WS_MESH_URL=
CARTRIDGEFI_API_URL=
