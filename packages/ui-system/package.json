  },
  "dependencies": {
    "@cartridgefi/shared-types": "workspace:*",
    "motion": "^12.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.3"
  }
