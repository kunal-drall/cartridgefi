  },
  "dependencies": {
    "@cartridgefi/sdk": "workspace:*",
    "@cartridgefi/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
