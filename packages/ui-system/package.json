{
  "name": "@cartridgefi/ui-system",
  "version": "2.0.0",
  "type": "module",
  "description": "CartridgeFi Liquid Glass UI primitives, Official Solana & MagicBlock vector lockups, and Hardware Cartridge cards",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
